## Database Schema

CREATE TABLE filings (
    id INTEGER PRIMARY KEY,
    ticker TEXT NOT NULL,
    cik TEXT NOT NULL,
    filing_type TEXT NOT NULL,
    period_end DATE NOT NULL,
    filed_date DATE NOT NULL,
    accession_number TEXT NOT NULL,
    raw_html_path TEXT,
    processed BOOLEAN DEFAULT FALSE
);

CREATE TABLE metrics (
    id INTEGER PRIMARY KEY,
    filing_id INTEGER REFERENCES filings(id),
    ticker TEXT NOT NULL,
    period_end DATE NOT NULL,
    pik_income DECIMAL,
    total_investment_income DECIMAL,
    pik_pct DECIMAL,
    non_accrual_cost DECIMAL,
    non_accrual_fair_value DECIMAL,
    total_portfolio_cost DECIMAL,
    total_portfolio_fair_value DECIMAL,
    non_accrual_cost_pct DECIMAL,
    weighted_avg_mark DECIMAL,
    nav_per_share DECIMAL,
    shares_outstanding DECIMAL,
    asset_coverage_ratio DECIMAL,
    nii_per_share DECIMAL,
    distributions_per_share DECIMAL,
    nii_coverage DECIMAL,
    unrealized_change DECIMAL,
    realized_gain_loss DECIMAL,
    fee_waiver_amount DECIMAL,
    fee_waiver_flag BOOLEAN DEFAULT FALSE,
    red_flag_score INTEGER,
    score_components TEXT,
    extraction_confidence TEXT,
    extraction_notes TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE positions (
    id INTEGER PRIMARY KEY,
    filing_id INTEGER REFERENCES filings(id),
    ticker TEXT NOT NULL,
    period_end DATE NOT NULL,
    company_name TEXT,
    investment_type TEXT,
    cost_basis DECIMAL,
    fair_value DECIMAL,
    mark_pct DECIMAL,
    is_non_accrual BOOLEAN DEFAULT FALSE,
    is_pik BOOLEAN DEFAULT FALSE,
    maturity_date DATE,
    position_rank INTEGER
);

CREATE TABLE alerts (
    id INTEGER PRIMARY KEY,
    ticker TEXT NOT NULL,
    alert_type TEXT NOT NULL,
    alert_date DATE NOT NULL,
    description TEXT,
    severity TEXT,
    metric_value DECIMAL,
    threshold_value DECIMAL,
    acknowledged BOOLEAN DEFAULT FALSE
);

CREATE TABLE eightk_events (
    id INTEGER PRIMARY KEY,
    ticker TEXT NOT NULL,
    filed_date DATE NOT NULL,
    item_number TEXT,
    event_type TEXT,
    description TEXT,
    raw_text TEXT,
    flagged BOOLEAN DEFAULT FALSE
);

